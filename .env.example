# Put these in Render > your SportyPredictz service > Environment. Never commit a real .env file.

# The key for THIS site (from your odds-api Supabase api_keys table).
ODDS_API_KEY_SPORTY=paste_the_key_here_on_render_only

# Your odds-api address (already the default, so you can skip this one).
ODDS_API_BASE=https://odds-api-g6vq.onrender.com

# OPTIONAL - you can leave this out. Only if you want to force your site's address (the onrender.com link from your Render service, NOT GitHub).
# SITE_URL=https://your-service.onrender.com

# Optional. Kick-off days are worked out in this time zone.
SITE_TZ=Africa/Lagos
PORT=3000
